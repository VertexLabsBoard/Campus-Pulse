# ==============================================================================
# CAMPUS PULSE — SUPABASE & MAIL OTP ENVIRONMENT VARIABLES
# ==============================================================================
# Copy this file to .env in your root or backend folder:
#   cp .env.example .env
#
# Then fill in your Supabase connection details from:
#   Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
# ==============================================================================

# ─── ACTIVE SPRING PROFILE ───────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=supabase

# ─── SUPABASE POSTGRESQL DATABASE ─────────────────────────────────────────────
# 1. Direct connection URI (port 5432):
#    jdbc:postgresql://db.<your-project-ref>.supabase.co:5432/postgres?sslmode=require
# 2. Or Session Pooler URI (recommended for cloud servers / port 6543):
#    jdbc:postgresql://aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
SUPABASE_DB_URL=jdbc:postgresql://db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=YOUR_SUPABASE_DATABASE_PASSWORD

# ─── SUPABASE PROJECT CREDENTIALS (OPTIONAL) ──────────────────────────────────
SUPABASE_PROJECT_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# ─── EMAIL OTP / SMTP CONFIGURATION ──────────────────────────────────────────
# Option 1: Gmail SMTP (Use Google Account App Password, not main password)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your.email@gmail.com
SPRING_MAIL_PASSWORD=your_16_char_app_password

# Option 2: Brevo (Sendinblue) - 300 free emails/day
# SPRING_MAIL_HOST=smtp-relay.brevo.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=your_brevo_login
# SPRING_MAIL_PASSWORD=your_brevo_smtp_key

# Option 3: Resend API (3,000 free emails/month)
RESEND_API_KEY=re_YOUR_API_KEY
RESEND_FROM=Campus Pulse <onboarding@resend.dev>

# Option 4: Resend SMTP
# SPRING_MAIL_HOST=smtp.resend.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=resend
# SPRING_MAIL_PASSWORD=re_YOUR_API_KEY

# Sender Address & Display Name
APP_MAIL_FROM=admissions-verify@amity.edu
APP_MAIL_FROM_NAME=Amity University Dispatch Portal
