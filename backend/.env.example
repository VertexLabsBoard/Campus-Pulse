# ==============================================================================
# CAMPUS PULSE — ENVIRONMENT VARIABLES
# ==============================================================================
# Copy this file to .env in your backend folder:
#   cp .env.example .env
#
# Fill in your Supabase connection details from:
#   Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
# ==============================================================================

# ─── ACTIVE SPRING PROFILE ───────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=supabase

# ─── SUPABASE POSTGRESQL DATABASE ─────────────────────────────────────────────
# 1. Direct connection URI (port 5432):
#    jdbc:postgresql://db.<your-project-ref>.supabase.co:5432/postgres?sslmode=require
# 2. Or Session Pooler URI (recommended for cloud servers):
#    jdbc:postgresql://aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
SUPABASE_DB_URL=jdbc:postgresql://db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=YOUR_SUPABASE_DATABASE_PASSWORD

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
APP_CORS_ORIGINS=https://your-frontend.onrender.com,http://localhost:5173

# ─── DEMO ACCOUNT CREDENTIALS ─────────────────────────────────────────────────
# These three accounts are provisioned on startup (idempotent).
# Override these in Render or your deployment platform's environment settings.
# NEVER commit real credentials to source control.
#
# Student demo account
DEMO_STUDENT_EMAIL=demo.student@s.amity.edu
DEMO_STUDENT_PASSWORD=CHANGE_ME_STUDENT_PASS

# Staff demo account
DEMO_STAFF_EMAIL=demo.staff@amity.edu
DEMO_STAFF_PASSWORD=CHANGE_ME_STAFF_PASS

# Admin demo account
DEMO_ADMIN_EMAIL=demo.admin@amity.edu
DEMO_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASS
