# ==============================================================================
# CAMPUS PULSE — SUPABASE & MAIL OTP ENVIRONMENT VARIABLES
# ==============================================================================
# Copy this file to .env in your root or backend folder:
#   cp .env.example .env
#
# Then fill in your Supabase connection details from:
#   Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
# ==============================================================================

# ─── ACTIVE SPRING PROFILE ───────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=supabase

# ─── SUPABASE POSTGRESQL DATABASE ─────────────────────────────────────────────
# 1. Direct connection URI (port 5432):
#    jdbc:postgresql://db.<your-project-ref>.supabase.co:5432/postgres?sslmode=require
# 2. Or Session Pooler URI (recommended for cloud servers / port 6543):
#    jdbc:postgresql://aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
SUPABASE_DB_URL=jdbc:postgresql://aws-0-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DB_USER=postgres.qezuosgmeextzeiewwck
SUPABASE_DB_PASSWORD=Vaivasvat@24

# ─── SUPABASE PROJECT CREDENTIALS (OPTIONAL) ──────────────────────────────────
# SUPABASE_PROJECT_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

