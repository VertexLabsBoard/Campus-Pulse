# ----------------------------------------------------------------------------
# Apache Maven Wrapper startup batch script, version 3.3.2
# ----------------------------------------------------------------------------

set -e

# Find the project base directory, from which this script is being run.
find_maven_basedir() {
  basedir=$(dirname "$0")
  wdir="$basedir"
  while [ "$wdir" != '/' ]; do
    if [ -d "$wdir"/.mvn ]; then
      basedir=$wdir
      break
    fi
    wdir=$(cd "$wdir/.."; pwd)
  done
  printf '%s' "$(cd "$basedir"; pwd)"
}

BASE_DIR=$(find_maven_basedir)
MAVEN_PROJECTBASEDIR=${MAVEN_BASEDIR:-"$BASE_DIR"}
export MAVEN_PROJECTBASEDIR
MAVEN_WRAPPER_PROPERTIES="$MAVEN_PROJECTBASEDIR/.mvn/wrapper/maven-wrapper.properties"

if [ -r "$MAVEN_WRAPPER_PROPERTIES" ]; then
  . "$MAVEN_WRAPPER_PROPERTIES"
fi

DISTRIBUTION_URL=${distributionUrl:-https://repo.maven.apache.org/maven2/org/apache/maven/apache-maven/3.9.9/apache-maven-3.9.9-bin.zip}
MAVEN_DIST_DIR="$HOME/.m2/wrapper/dists"
DIST_FILENAME=$(basename "$DISTRIBUTION_URL")
DIST_NAME="${DIST_FILENAME%.zip}"
MAVEN_HOME="$MAVEN_DIST_DIR/$DIST_NAME"

if [ ! -d "$MAVEN_HOME" ]; then
  echo "Downloading Maven from $DISTRIBUTION_URL"
  mkdir -p "$MAVEN_DIST_DIR"
  TMP_DOWNLOAD_DIR=$(mktemp -d)
  if command -v curl > /dev/null; then
    curl -fLo "$TMP_DOWNLOAD_DIR/$DIST_FILENAME" "$DISTRIBUTION_URL"
  else
    wget -O "$TMP_DOWNLOAD_DIR/$DIST_FILENAME" "$DISTRIBUTION_URL"
  fi
  unzip -q "$TMP_DOWNLOAD_DIR/$DIST_FILENAME" -d "$MAVEN_DIST_DIR"
  rm -rf "$TMP_DOWNLOAD_DIR"
fi

MAVEN_CMD="$MAVEN_HOME/bin/mvn"
exec "$MAVEN_CMD" "$@"
