#!/bin/sh
# ----------------------------------------------------------------------------
# Apache Maven Wrapper startup script
# ----------------------------------------------------------------------------

set -e

# Find the project base directory
find_maven_basedir() {
  basedir=$(dirname "$0")
  wdir="$basedir"
  while [ "$wdir" != '/' ]; do
    if [ -d "$wdir"/.mvn ]; then
      basedir=$wdir
      break
    fi
    wdir=$(cd "$wdir/.."; pwd)
  done
  printf '%s' "$(cd "$basedir"; pwd)"
}

BASE_DIR=$(find_maven_basedir)
MAVEN_PROJECTBASEDIR=${MAVEN_BASEDIR:-"$BASE_DIR"}
export MAVEN_PROJECTBASEDIR
MAVEN_WRAPPER_PROPERTIES="$MAVEN_PROJECTBASEDIR/.mvn/wrapper/maven-wrapper.properties"

if [ -r "$MAVEN_WRAPPER_PROPERTIES" ]; then
  distributionUrl=$(grep -E "^distributionUrl=" "$MAVEN_WRAPPER_PROPERTIES" | cut -d'=' -f2- | tr -d '\r')
fi

DISTRIBUTION_URL=${distributionUrl:-https://repo.maven.apache.org/maven2/org/apache/maven/apache-maven/3.9.6/apache-maven-3.9.6-bin.zip}
MAVEN_DIST_DIR="$HOME/.m2/wrapper/dists"
DIST_FILENAME=$(basename "$DISTRIBUTION_URL")
DIST_NAME="${DIST_FILENAME%.zip}"
DIST_FOLDER="${DIST_NAME%-bin}"
MAVEN_HOME="$MAVEN_DIST_DIR/$DIST_FOLDER"

if [ ! -d "$MAVEN_HOME" ]; then
  echo "Downloading Maven from $DISTRIBUTION_URL ..."
  mkdir -p "$MAVEN_DIST_DIR"
  TMP_DOWNLOAD_DIR=$(mktemp -d)
  if command -v curl > /dev/null 2>&1; then
    curl -fsSL -o "$TMP_DOWNLOAD_DIR/$DIST_FILENAME" "$DISTRIBUTION_URL"
  elif command -v wget > /dev/null 2>&1; then
    wget -q -O "$TMP_DOWNLOAD_DIR/$DIST_FILENAME" "$DISTRIBUTION_URL"
  fi
  unzip -q -o "$TMP_DOWNLOAD_DIR/$DIST_FILENAME" -d "$MAVEN_DIST_DIR"
  rm -rf "$TMP_DOWNLOAD_DIR"
fi

MAVEN_CMD=""
if [ -x "$MAVEN_HOME/bin/mvn" ]; then
  MAVEN_CMD="$MAVEN_HOME/bin/mvn"
elif [ -x "$MAVEN_DIST_DIR/$DIST_NAME/bin/mvn" ]; then
  MAVEN_CMD="$MAVEN_DIST_DIR/$DIST_NAME/bin/mvn"
else
  MAVEN_CMD=$(find "$MAVEN_DIST_DIR" -type f -name mvn 2>/dev/null | head -n 1)
fi

if [ -n "$MAVEN_CMD" ] && [ -f "$MAVEN_CMD" ]; then
  chmod +x "$MAVEN_CMD"
  exec "$MAVEN_CMD" "$@"
fi

if command -v mvn > /dev/null 2>&1; then
  exec mvn "$@"
fi

echo "ERROR: Maven could not be found or executed." >&2
exit 1
